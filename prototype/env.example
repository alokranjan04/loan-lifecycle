# ── LLM (required for real pipeline runs) ─────────────────────────────────────
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: pin a specific model (default: anthropic/claude-sonnet-4-5)
# LOAN_AGENT_MODEL=anthropic/claude-sonnet-4-5

# ── Qdrant Cloud (required for Hybrid RAG; omit to use BM25-only fallback) ────
# Cluster URL from https://cloud.qdrant.io (format: https://<uuid>.us-west-1-0.aws.cloud.qdrant.io:6333)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-west-1-0.aws.cloud.qdrant.io:6333
# API key (JWT) from Qdrant Cloud dashboard → Access → API Keys
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Local dev only ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and never committed.
# In GCP Cloud Run, all values above are injected via Secret Manager — no file needed.
